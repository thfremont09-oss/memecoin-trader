# Copy this file to .env and fill in what you have.
# Nothing here is required to run the simulation — it works out of the box
# with a simulated Twitter feed and real Solana market data.

# --- Twitter / X (optional) ---
# Leave blank to use the built-in simulated hype feed (real market data,
# synthetic "mentions"). Fill in to switch to real tweet scanning.
# Requires an X API v2 plan with access to recent search (paid tier).
TWITTER_BEARER_TOKEN=

# --- Reddit (optional) ---
# Free, official API — no scraping involved. Create a "script" app at
# https://www.reddit.com/prefs/apps (create app > script), then set
# signals.reddit.enabled: true in config.yaml and fill these in:
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=memecoin-trader-bot/1.0

# --- Birdeye (optional) ---
# Free-tier API key from https://birdeye.so/data-api (self-serve signup,
# no approval wait). Powers the trending-tokens signal source
# (signals.birdeye.enabled in config.yaml, on by default but inert without
# this key).
BIRDEYE_API_KEY=

# --- Farcaster (optional) ---
# Free-tier API key from https://neynar.com (self-serve signup, no
# approval wait). Powers the Farcaster cast-search signal source
# (signals.farcaster.enabled in config.yaml, on by default but inert
# without this key). Bluesky, 4chan/biz, DexScreener boosted tokens,
# GeckoTerminal trending pools, and Raydium pools need no key at all --
# all five are already active with no setup.
NEYNAR_API_KEY=

# --- Telegram (optional) ---
# Free api_id/api_hash from https://my.telegram.org (log in with your phone
# number > API development tools > create an app). Powers the Telegram
# channel signal source (signals.telegram.enabled in config.yaml, off by
# default -- also needs a one-time login via
# `python scripts/telegram_login_setup.py` and a list of channels under
# signals.telegram.channels). See README's "Telegram" section.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# --- Live trading (optional, off by default, Solana only) ---
# DO NOT fill these in until you have read README.md's "Going live" section.
# The bot will refuse to place real trades unless ALL of the following are set.
MODE=paper
I_UNDERSTAND_LIVE_TRADING_RISK=
SOLANA_PRIVATE_KEY=
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
